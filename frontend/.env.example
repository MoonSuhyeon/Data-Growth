# 각 서비스 주소. 콘솔은 이 값으로만 서비스를 찾는다.
BOOKING_API_URL=http://127.0.0.1:8000
FORECAST_API_URL=http://127.0.0.1:8001
CONTENT_API_URL=http://127.0.0.1:8002
SUPPORT_API_URL=http://127.0.0.1:8003

# ── 데모 모드 ─────────────────────────────────────────────────
# `enabled` 면 MSW 가 모든 API 를 가로채고, 위 주소는 쓰이지 않는다.
# 백엔드 넷을 띄우지 않고 화면만 보여줄 때 쓴다(예: Vercel 심사용 배포).
#
# **기본은 꺼짐이다.** 값을 넣지 않으면 실제 백엔드로 나간다 —
# 목이 기본이면 실물이 죽은 것을 못 알아채고 그 상태로 배포까지 간다.
#
# 데모 모드에서는 관리자 세션도 목이 준다. 로그인 없이 /admin/* 을 볼 수 있고,
# 실제 인증 코드는 그대로 남아 있어 이 값을 빼면 원래대로 돈다.
NEXT_PUBLIC_API_MOCKING=disabled
