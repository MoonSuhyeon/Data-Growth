// Stay Booking ERD — 57 Tables
// SQLAlchemy 모델(backend/app/models/base.py)에서 생성했다.
// https://dbdiagram.io 에 붙여넣으면 그림이 나온다.

Project StayBooking {
  database_type: 'PostgreSQL'
  Note: '숙박 예약 서비스 — 이벤트 수집·퍼널·실험 파이프라인의 이벤트 소스'
}

// ==========================================================
// 코드 테이블 — 14개
// ==========================================================

Table bed_type_codes {
  code varchar(30) [pk, not null]
  name varchar(100) [not null]
  description text [null]
  display_order int [not null]
  is_active boolean [not null]
}

Table booking_status_codes {
  code varchar(30) [pk, not null]
  name varchar(100) [not null]
  description text [null]
  display_order int [not null]
  is_active boolean [not null]
}

Table coupon_status_codes {
  code varchar(30) [pk, not null]
  name varchar(100) [not null]
  description text [null]
  display_order int [not null]
  is_active boolean [not null]
}

Table coupon_type_codes {
  code varchar(30) [pk, not null]
  name varchar(100) [not null]
  description text [null]
  display_order int [not null]
  is_active boolean [not null]
}

Table payment_method_codes {
  code varchar(30) [pk, not null]
  name varchar(100) [not null]
  description text [null]
  display_order int [not null]
  is_active boolean [not null]
}

Table payment_status_codes {
  code varchar(30) [pk, not null]
  name varchar(100) [not null]
  description text [null]
  display_order int [not null]
  is_active boolean [not null]
}

Table property_status_codes {
  code varchar(30) [pk, not null]
  name varchar(100) [not null]
  description text [null]
  display_order int [not null]
  is_active boolean [not null]
}

Table property_type_codes {
  code varchar(30) [pk, not null]
  name varchar(100) [not null]
  description text [null]
  display_order int [not null]
  is_active boolean [not null]
}

Table review_status_codes {
  code varchar(30) [pk, not null]
  name varchar(100) [not null]
  description text [null]
  display_order int [not null]
  is_active boolean [not null]
}

Table room_grade_codes {
  code varchar(30) [pk, not null]
  name varchar(100) [not null]
  description text [null]
  display_order int [not null]
  is_active boolean [not null]
}

Table room_status_codes {
  code varchar(30) [pk, not null]
  name varchar(100) [not null]
  description text [null]
  display_order int [not null]
  is_active boolean [not null]
}

Table user_role_codes {
  code varchar(30) [pk, not null]
  name varchar(100) [not null]
  description text [null]
  display_order int [not null]
  is_active boolean [not null]
}

Table user_status_codes {
  code varchar(30) [pk, not null]
  name varchar(100) [not null]
  description text [null]
  display_order int [not null]
  is_active boolean [not null]
}

Table voucher_status_codes {
  code varchar(30) [pk, not null]
  name varchar(100) [not null]
  description text [null]
  display_order int [not null]
  is_active boolean [not null]
}

// ==========================================================
// 회원 · 인증 — 4개
// ==========================================================

Table terms {
  id uuid [pk, not null]
  type termtypeenum [not null]
  version int [not null]
  content text [not null]
  required boolean [not null]
  effective_from timestamp [not null]
}

Table users {
  id uuid [pk, not null]
  email varchar(255) [unique, null]
  hashed_password varchar(255) [null]
  name varchar(100) [not null]
  phone varchar(20) [null]
  role roleenum [not null]
  is_guest boolean [not null]
  guest_expires_at timestamp [null]
  created_at timestamp [not null]
  updated_at timestamp [not null]
  status_code varchar(30) [null, ref: > user_status_codes.code]
  point_balance int [null]
  indexes {
    (email)
    (is_guest)
  }
}

Table identity_verifications {
  id uuid [pk, not null]
  user_id uuid [not null, ref: > users.id]
  verified_at timestamp [null]
  expires_at timestamp [null]
}

Table term_agreements {
  id uuid [pk, not null]
  user_id uuid [not null, ref: > users.id]
  term_id uuid [not null, ref: > terms.id]
  agreed_at timestamp [not null]
  indexes {
    (user_id, term_id) [unique]
  }
}

// ==========================================================
// 숙소 · 재고 — 8개
// ==========================================================

Table amenities {
  id uuid [pk, not null]
  name varchar(50) [unique, not null]
}

Table board_types {
  id uuid [pk, not null]
  code varchar(20) [unique, not null]
  name varchar(50) [not null]
  extra_charge int [not null]
  description text [null]
}

Table properties {
  id uuid [pk, not null]
  name varchar(255) [not null]
  name_en varchar(255) [null]
  description text [not null]
  host_name varchar(100) [not null]
  highlights text [not null]
  max_guests int [not null]
  property_type propertytypeenum [not null]
  photo_url varchar(512) [null]
  listed_at timestamp [null]
  status propertystatusenum [not null]
  delisted_at timestamp [null]
  brand varchar(100) [null]
  total_bookings int [null]
  booking_rank int [null]
  avg_rating numeric(3, 2) [null]
  review_count int [null]
  region varchar(50) [not null]
  address varchar(255) [not null]
  phone varchar(20) [not null]
  latitude numeric(10, 7) [null]
  longitude numeric(10, 7) [null]
  parking_available boolean [null]
  parking_count int [null]
  indexes {
    (region)
  }
}

Table property_amenities {
  property_id uuid [pk, not null, ref: > properties.id]
  amenity_id uuid [pk, not null, ref: > amenities.id]
}

Table property_board_types {
  property_id uuid [pk, not null, ref: > properties.id]
  board_type_id uuid [pk, not null, ref: > board_types.id]
}

Table room_types {
  id uuid [pk, not null]
  property_id uuid [not null, ref: > properties.id]
  name varchar(50) [not null]
  total_rooms int [not null]
  bed_type_code varchar(30) [null, ref: > bed_type_codes.code]
  location_detail varchar(100) [null]
  standard_room_count int [null]
  deluxe_room_count int [null]
  accessible_room_count int [null]
}

Table rooms {
  id uuid [pk, not null]
  room_type_id uuid [not null, ref: > room_types.id]
  floor varchar(3) [not null]
  number int [not null]
  room_grade roomgradeenum [not null]
  status_code varchar(30) [null, ref: > room_status_codes.code]
  indexes {
    (room_type_id, floor, number) [unique]
  }
}

Table stay_dates {
  id uuid [pk, not null]
  property_id uuid [not null, ref: > properties.id]
  room_type_id uuid [not null, ref: > room_types.id]
  board_type_id uuid [null, ref: > board_types.id]
  check_in timestamp [not null]
  check_out timestamp [not null]
  stay_date timestamp [not null]
  nights int [null]
  booked_rooms int [null]
  occupancy_rate numeric(5, 2) [null]
  indexes {
    (stay_date)
    (room_type_id, check_in)
    (property_id, stay_date)
  }
}

// ==========================================================
// 예약 · 결제 — 11개
// ==========================================================

Table guest_types {
  id uuid [pk, not null]
  code varchar(20) [unique, not null]
  name varchar(50) [not null]
  discount_amount int [not null]
  description text [null]
  is_active boolean [not null]
  created_at timestamp [not null]
}

Table peak_dates {
  id uuid [pk, not null]
  date date [unique, not null]
  name varchar(100) [not null]
  extra_charge int [not null]
  description text [null]
}

Table rate_plans {
  id uuid [pk, not null]
  day_type daytypeenum [not null]
  season seasonenum [not null]
  room_grade roomgradeenum [not null]
  price int [not null]
  indexes {
    (day_type, season, room_grade) [unique]
  }
}

Table bookings {
  id uuid [pk, not null]
  booking_number varchar(36) [unique, not null]
  user_id uuid [not null, ref: > users.id]
  stay_date_id uuid [not null, ref: > stay_dates.id]
  total_price int [not null]
  status bookingstatusenum [not null]
  booked_at timestamp [not null]
  guest_breakdown json [null]
  coupon_discount int [null]
  points_used int [null]
  indexes {
    (booking_number)
  }
}

Table room_holds {
  id uuid [pk, not null]
  stay_date_id uuid [not null, ref: > stay_dates.id]
  room_id uuid [not null, ref: > rooms.id]
  user_id uuid [null, ref: > users.id]
  session_id varchar(255) [null]
  held_at timestamp [not null]
  expires_at timestamp [not null]
  indexes {
    (expires_at)
    (stay_date_id, room_id) [unique]
  }
}

Table booking_rooms {
  id uuid [pk, not null]
  booking_id uuid [not null, ref: > bookings.id]
  room_id uuid [not null, ref: > rooms.id]
  price int [not null]
  indexes {
    (booking_id, room_id) [unique]
  }
}

Table payments {
  id uuid [pk, not null]
  booking_id uuid [unique, not null, ref: > bookings.id]
  payment_method paymentmethodenum [not null]
  amount int [not null]
  status paymentstatusenum [not null]
  approval_number varchar(100) [null]
  approved_at timestamp [null]
  pg_transaction_id varchar(100) [null]
  method_code varchar(30) [null, ref: > payment_method_codes.code]
  status_code varchar(30) [null, ref: > payment_status_codes.code]
}

Table receipts {
  id uuid [pk, not null]
  booking_id uuid [unique, not null, ref: > bookings.id]
  receipt_number varchar(50) [unique, not null]
  receipt_type receipttypeenum [not null]
  issued_at timestamp [not null]
  total_amount int [not null]
  tax_amount int [not null]
  issuer_name varchar(100) [null]
  issuer_registration_number varchar(20) [null]
}

Table refunds {
  id uuid [pk, not null]
  booking_id uuid [unique, not null, ref: > bookings.id]
  refund_amount int [not null]
  reason text [null]
  status refundstatusenum [not null]
  requested_at timestamp [not null]
  processed_at timestamp [null]
}

Table room_change_histories {
  id uuid [pk, not null]
  booking_id uuid [not null, ref: > bookings.id]
  old_room_ids json [not null]
  new_room_ids json [not null]
  changed_at timestamp [not null]
  reason text [null]
}

Table stay_vouchers {
  id uuid [pk, not null]
  booking_room_id uuid [unique, not null, ref: > booking_rooms.id]
  qr_code varchar(36) [unique, not null]
  status voucherstatusenum [not null]
  issued_at timestamp [not null]
  used_at timestamp [null]
}

// ==========================================================
// 혜택 — 12개
// ==========================================================

Table addon_categories {
  id uuid [pk, not null]
  name varchar(50) [not null]
  display_order int [not null]
  is_active boolean [not null]
}

Table discount_combination_rules {
  id uuid [pk, not null]
  discount_a varchar(30) [not null]
  discount_b varchar(30) [not null]
  is_stackable boolean [not null]
  description text [null]
}

Table partners {
  id uuid [pk, not null]
  name varchar(100) [not null]
  code varchar(30) [unique, not null]
  description text [null]
  logo_url varchar(512) [null]
  is_active boolean [not null]
  created_at timestamp [not null]
}

Table addon_items {
  id uuid [pk, not null]
  category_id uuid [not null, ref: > addon_categories.id]
  name varchar(100) [not null]
  price int [not null]
  description text [null]
  image_url varchar(512) [null]
  is_available boolean [not null]
  display_order int [not null]
}

Table coupon_masters {
  id uuid [pk, not null]
  code varchar(50) [unique, not null]
  name varchar(100) [not null]
  type_code varchar(30) [not null, ref: > coupon_type_codes.code]
  discount_value int [not null]
  min_booking_amount int [not null]
  max_discount_amount int [null]
  valid_from timestamp [not null]
  valid_to timestamp [not null]
  max_issues int [null]
  issued_count int [not null]
  is_active boolean [not null]
  created_at timestamp [not null]
}

Table membership_products {
  id uuid [pk, not null]
  partner_id uuid [not null, ref: > partners.id]
  name varchar(100) [not null]
  discount_type varchar(20) [not null]
  discount_value int [not null]
  monthly_price int [not null]
  is_active boolean [not null]
  created_at timestamp [not null]
}

Table addon_options {
  id uuid [pk, not null]
  item_id uuid [not null, ref: > addon_items.id]
  name varchar(100) [not null]
  price int [not null]
  is_available boolean [not null]
}

Table memberships {
  id uuid [pk, not null]
  user_id uuid [not null, ref: > users.id]
  product_id uuid [not null, ref: > membership_products.id]
  status varchar(20) [not null]
  started_at timestamp [not null]
  expires_at timestamp [null]
  cancelled_at timestamp [null]
  indexes {
    (user_id, product_id) [unique]
  }
}

Table user_coupons {
  id uuid [pk, not null]
  user_id uuid [not null, ref: > users.id]
  coupon_master_id uuid [not null, ref: > coupon_masters.id]
  status_code varchar(30) [not null, ref: > coupon_status_codes.code]
  issued_at timestamp [not null]
  used_at timestamp [null]
  expires_at timestamp [null]
}

Table booking_addons {
  id uuid [pk, not null]
  booking_id uuid [not null, ref: > bookings.id]
  item_id uuid [not null, ref: > addon_items.id]
  option_id uuid [null, ref: > addon_options.id]
  quantity int [not null]
  unit_price int [not null]
}

Table coupon_usages {
  id uuid [pk, not null]
  user_coupon_id uuid [not null, ref: > user_coupons.id]
  booking_id uuid [not null, ref: > bookings.id]
  discount_amount int [not null]
  used_at timestamp [not null]
}

Table point_histories {
  id uuid [pk, not null]
  user_id uuid [not null, ref: > users.id]
  type varchar(20) [not null]
  amount int [not null]
  balance_after int [not null]
  booking_id uuid [null, ref: > bookings.id]
  description varchar(200) [null]
  created_at timestamp [not null]
}

// ==========================================================
// 리뷰 · 알림 · 로그 — 8개
// ==========================================================

Table admin_audit_logs {
  id uuid [pk, not null]
  admin_id uuid [not null, ref: > users.id]
  action varchar(50) [not null]
  resource_type varchar(50) [not null]
  resource_id varchar(100) [null]
  before_data json [null]
  after_data json [null]
  ip_address varchar(45) [null]
  created_at timestamp [not null]
}

Table notification_settings {
  id uuid [pk, not null]
  user_id uuid [unique, not null, ref: > users.id]
  email_enabled boolean [not null]
  sms_enabled boolean [not null]
  push_enabled boolean [not null]
  booking_notification boolean [not null]
  refund_notification boolean [not null]
  marketing_notification boolean [not null]
  updated_at timestamp [not null]
}

Table user_activities {
  id uuid [pk, not null]
  user_id uuid [not null, ref: > users.id]
  type varchar(50) [not null]
  description varchar(300) [null]
  ip_address varchar(45) [null]
  created_at timestamp [not null]
}

Table wishlists {
  id uuid [pk, not null]
  user_id uuid [not null, ref: > users.id]
  property_id uuid [not null, ref: > properties.id]
  created_at timestamp [not null]
  indexes {
    (user_id, property_id) [unique]
  }
}

Table notifications {
  id uuid [pk, not null]
  user_id uuid [not null, ref: > users.id]
  type notificationtypeenum [not null]
  title varchar(200) [not null]
  body text [null]
  is_read boolean [not null]
  created_at timestamp [not null]
  related_booking_id uuid [null, ref: > bookings.id]
}

Table reviews {
  id uuid [pk, not null]
  user_id uuid [not null, ref: > users.id]
  property_id uuid [not null, ref: > properties.id]
  booking_id uuid [null, ref: > bookings.id]
  rating int [not null]
  content text [null]
  status_code varchar(30) [not null, ref: > review_status_codes.code]
  is_spoiler boolean [not null]
  helpful_count int [not null]
  created_at timestamp [not null]
  updated_at timestamp [not null]
  indexes {
    (user_id, property_id) [unique]
  }
}

Table review_helpfuls {
  review_id uuid [pk, not null, ref: > reviews.id]
  user_id uuid [pk, not null, ref: > users.id]
  created_at timestamp [not null]
}

Table review_reports {
  id uuid [pk, not null]
  review_id uuid [not null, ref: > reviews.id]
  user_id uuid [not null, ref: > users.id]
  reason varchar(200) [null]
  created_at timestamp [not null]
  indexes {
    (review_id, user_id) [unique]
  }
}
